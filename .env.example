# Copy to .env and fill in. Never commit .env.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Absolute base used for links inside invitation emails.
SITE_URL=http://localhost:8000

# Email. The default console backend prints invitations to the terminal,
# which is all local development needs. Set a real host to actually send.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
